# Voice Thief environment variables
# Copy to .env.local and fill in your keys.
# When VT_MOCK_AI=1, all ElevenLabs/Anthropic calls are stubbed and the game
# is fully playable without any keys.

# Toggle mock mode (set to "0" or remove to use real APIs)
VT_MOCK_AI=1

# ElevenLabs
ELEVENLABS_API_KEY=

# Optional experimental ConvAI agent provisioning. Normal play uses
# deterministic puzzle rules for phone conversations.
ELEVENLABS_ENABLE_CONVAI_AGENTS=0

# Conversational AI agent IDs. Used only when ELEVENLABS_ENABLE_CONVAI_AGENTS=1.
# Leave blank to have /api/bootstrap create them on first boot.
ELEVENLABS_AGENT_ID_BANK_MANAGER=
ELEVENLABS_AGENT_ID_SECRETARY=
ELEVENLABS_AGENT_ID_BANK_GUARD=
ELEVENLABS_AGENT_ID_WIFE=

# Optional TTS model override. The default renderer uses eleven_multilingual_v2
# for more human NPC delivery.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional pre-pinned NPC voice IDs (Voice Library). Leave blank to use the
# premade cast in src/config/voices.ts.
ELEVENLABS_VOICE_ID_BANK_MANAGER=
ELEVENLABS_VOICE_ID_SECRETARY=
ELEVENLABS_VOICE_ID_BANK_GUARD=
ELEVENLABS_VOICE_ID_WIFE=

# Anthropic (used only when full ConvAI is unavailable; optional)
ANTHROPIC_API_KEY=

# Build metadata
NEXT_PUBLIC_GAME_VERSION=0.1.0
